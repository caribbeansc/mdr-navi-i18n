   "src": "03874b89f279",
   "t": "<FACE:00>Se ven en aprietos…"
  },
  {
   "key": "script:0039:03F2",
   "src": "314ae53d4e7c",
   "t": "<FACE:81>¡Ah! ¡<PLAYER>-robo!"
  },
  {
   "key": "script:0039:03FC",
   "src": "ae7e8e03760b",
   "t": "<FACE:6D>¡¿Ya llegaron?!"
  },
  {
   "key": "script:0039:040B",
   "src": "5d36b76be0ad",
   "t": "<FACE:7F>¿Entonces ya no hay<NL>que moverla-robo?"
