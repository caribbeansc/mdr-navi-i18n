 "entries": [
  {
   "key": "script:0039:035E",
   "src": "b999ef3b08a1",
   "t": "<FACE:6C>¡Deprisa!<WAIT>¡Si no se apuran<NL>esos van a llegar!"
  },
  {
   "key": "script:0039:0381",
   "src": "ef202ff0d1f7",
   "t": "<FACE:7D>Dice eso, pero esta<NL>roca no se mueve-robo"
  },
  {
   "key": "script:0039:039C",
   "src": "68758350d912",
   "t": "<FACE:6C>¡Son unos inútiles!<NL>"
  },
  {
   "key": "script:0039:03A9",
   "src": "2fb84aa7236a",
   "t": "<FACE:6C>¡Así no sirven para<NL>la Banda Sperobo!"
  },
  {
   "key": "script:0039:03C6",
   "src": "c4e5d3dac7be",
   "t": "<FACE:6C>¡Tapen la entrada con<NL>esa roca como sea!"
