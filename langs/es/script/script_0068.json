  {
   "key": "script:0068:0A4B",
   "src": "f968331777e2",
   "t": "<FACE:03>¿Eh?<NL>"
  },
  {
   "key": "script:0068:0A52",
   "src": "155c4d4c3f9b",
   "t": "<FACE:03>¡Ah, esperen…!<NL>"
  },
  {
   "key": "script:0068:0A5F",
   "src": "f130e9b65cc1",
