  },
  {
   "key": "script:0068:11EC",
   "src": "0ee5ef975840",
   "t": "<FACE:0A>¿Banda Sperobo?<NL><WAIT><FACE:0E>Ni idea…"
  },
  {
   "key": "script:0068:1203",
