{
 "part": "script/script_0034",
 "entries": [
  {
   "key": "script:0034:052C",
   "src": "8a11f7667874",
   "t": "<FACE:12>Un ataque de Medabots<NL><WAIT>jamás podría dañar al<NL>Cluster… ¡imposible!<WAIT>¿Pero qué es esto…?"
  },
  {
   "key": "script:0034:056B",
   "src": "ef7980a3a2f3",
   "t": "<FACE:10>(Esto es malo…)<NL><WAIT>(Esa sala controla los<NL>Medabots expuestos)<WAIT>(¡Si la destruyen…!)"
  },
  {
   "key": "script:0034:05B2",
   "src": "b9204c126676",
   "t": "<FACE:10>¡Rayos…!"
  },
  {
   "key": "script:0034:05BB",
   "src": "922dcfa972d6",
   "t": "<FACE:08>¡O-oye! ¿Adónde vas?"
  },
  {
   "key": "script:0034:05CE",
   "src": "08ac953304d8",
   "t": "<FACE:22>¡Cálmense todos!"
  },
  {
   "key": "script:0034:05E6",
   "src": "8d9d3d07b982",
   "t": "<FACE:10>¡A un lado!"
  },
  {
   "key": "script:0034:05ED",
   "src": "78e248fb6737",
   "t": "<FACE:25>¡Iiiiiih!<NL>"
  },
  {
   "key": "script:0034:05F6",
   "src": "ac3298bc561c",
   "t": "<FACE:25>¡Guaaaaah!!"
  },
  {
   "key": "script:0034:0601",
   "src": "181a3b6f7ef3",
   "t": "<FACE:05>¡Perdóooon!"
  },
  {
   "key": "script:0034:060A",
   "src": "c961e4beebb3",
   "t": "<FACE:07>(Je je, se lo merece<NL>por lo de <PLAYER>)"
  },
  {
   "key": "script:0034:062B",
   "src": "4937801e235a",
   "t": "<FACE:06>¡Oye! ¡T-tú, sí, tú!<NL><WAIT>¡No huyas! ¡R-responde<NL>mi pregunta!<NL>"
  },
  {
   "key": "script:0034:0658",
   "src": "fa9782277d55",
   "t": "<FACE:06>¡¿Me estás oyendo?!<NL><WAIT>Contéstame al menos…<NL>"
  },
  {
   "key": "script:0034:0671",
   "src": "2aeb47b6b4d6",
   "t": "<FACE:08>No… puede ser…<NL>¿Por qué…?<WAIT>¡Cómo pudo pasar algo<NL>así…!"
  },
  {
   "key": "script:0034:068E",
   "src": "2f9713b74a97",
   "t": "<FACE:12>Fue él…<WAIT>Cuesta creerlo, pero<NL>no hay otra opción…<WAIT>¿Y el sistema perfecto<NL>del Cluster…?"
  },
  {
   "key": "script:0034:06D3",
   "src": "734986817017",
   "t": "<FACE:60>¡¿Qué ocurre?!<NL><WAIT>¡¿Por qué el Cluster<NL>deja su órbita?!"
  },
  {
   "key": "script:0034:06F1",
   "src": "3963e51c83c0",
   "t": "<FACE:60>¡No lo sabemos!<NL><WAIT>¡Alguien encendió los<NL>motores de ajuste!"
  },
  {
   "key": "script:0034:0725",
   "src": "f6366236ce62",
   "t": "<FACE:60>¡La protección de Navi<NL>jamás lo permitiría!"
  },
  {
   "key": "script:0034:0750",
   "src": "9f5edf9ed56c",
   "t": "<FACE:60>¡Esa Navi está fuera<NL>de servicio ahora!"
  },
  {
   "key": "script:0034:076B",
   "src": "7ec332d06faa",
   "t": "<FACE:60>¡¿Cómo dices?!<NL><WAIT>¡¿Y el área de mando?!<NL>¡¿Qué pasa adentro?!"
  },
  {
   "key": "script:0034:0798",
   "src": "b34f8b2995c7",
   "t": "<FACE:60>Desde hoy Navi opera<NL>a plena capacidad…<WAIT>¡y se redujo mucho el<NL>personal!<NL>"
  },
  {
   "key": "script:0034:07CB",
   "src": "77deabbf5f79",
   "t": "<FACE:60>Ahora en el Cluster…<NL>"
  },
  {
   "key": "script:0034:07E0",
   "src": "1d872a338412",
   "t": "<FACE:60>¡No queda personal!<NL>"
  },
  {
   "key": "script:0034:07F8",
   "src": "14b5b810243e",
   "t": "<FACE:60>Dentro del Cluster…<NL>"
  },
  {
   "key": "script:0034:0813",
   "src": "174923da3dff",
   "t": "<FACE:60>¡S-solo hay niños!"
  },
  {
   "key": "script:0034:0828",
   "src": "c1480acb8782",
   "t": "<FACE:06>¡No te quedes ahí!<NL><WAIT>Sabes dónde está<NL><PLAYER>, ¿verdad?<WAIT>¡Dímelo ya!"
  },
  {
   "key": "script:0034:0856",
   "src": "ead410dc7ea1",
   "t": "<FACE:03>¿Eh? Hiyori"
  },
  {
   "key": "script:0034:0860",
   "src": "cae8a9041089",
   "t": "<FACE:06>¡Nada de «¿eh?»!<NL>¡¿Dónde te metiste?!"
  },
  {
   "key": "script:0034:087A",
   "src": "2d337d0befa0",
   "t": "<FACE:09>Y-yo… con lo que me<NL>preocupé por ti…<WAIT><FACE:00>No me digas, Hiyori…<WAIT><FACE:02>¿Estabas preocupada?"
  },
  {
   "key": "script:0034:08AF",
   "src": "bc88ad271c42",
   "t": "<FACE:06>¡Tonto!"
  },
  {
   "key": "script:0034:08B6",
   "src": "125125f73505",
   "t": "<FACE:03>¡Auch!"
  },
  {
   "key": "script:0034:08BE",
   "src": "b278b03e49f7",
   "t": "<FACE:04>(¿Desde cuándo una<NL>chica pega con puño?)<WAIT>(¡Con el puño…!)"
  },
  {
   "key": "script:0034:08E1",
   "src": "6a20c0bf8c52",
   "t": "<FACE:05>¿Ese tipo no te hizo<NL>algo malo?<WAIT>¿No te duele nada?<NL>¿Estás bien?"
  },
  {
   "key": "script:0034:090E",
   "src": "053ffc7a6e6e",
   "t": "<FACE:00>…Sí, yo estoy bien<WAIT><FACE:01>Pero lo que hizo ese<NL>tipo no es broma"
  },
  {
   "key": "script:0034:093F",
   "src": "160d64f02d03",
   "t": "<FACE:03>¡Uah!<WAIT><FACE:08>¡Aaay!"
  },
  {
   "key": "script:0034:094D",
   "src": "66efd10c9af5",
   "t": "<FACE:03>¡Ugh!<WAIT><FACE:08>¡Ay!"
  },
  {
   "key": "script:0034:095B",
   "src": "075d1cdb59ec",
   "t": "<FACE:06>¡¿Dónde me tocas?!"
  },
  {
   "key": "script:0034:0969",
   "src": "f20ac92215a3",
   "t": "<FACE:04>(Me pisa, me patea…)"
  },
  {
   "key": "script:0034:097C",
   "src": "5843cb3f8c2b",
   "t": "<FACE:05>Pero… esto está feo<NL><WAIT>¿Qué será de nosotros<NL>ahora…?"
  },
  {
   "key": "script:0034:099E",
   "src": "000d0c62b8f0",
   "t": "<FACE:04>¿Qué quieres decir?<NL><WAIT>Hace poco tembló todo<NL>¿Qué está pasando?"
  },
  {
   "key": "script:0034:09C9",
   "src": "5af6d76c0d6c",
   "t": "<FACE:05>Parece que el Cluster<NL>va a la deriva<WAIT><FACE:03>…¿Eh?"
  },
  {
   "key": "script:0034:09EC",
   "src": "24f409d44c39",
   "t": "<FACE:05>Nosotros…<NL><WAIT>¡Que tal vez quedamos<NL>aislados!"
  }
 ]
}
