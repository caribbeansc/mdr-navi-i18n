  {
   "key": "script:0015:0519",
   "src": "12b4c0b19375",
   "t": "<FACE:7D>Señorita Kirika…-robo"
  },
  {
   "key": "script:0015:0526",
   "src": "68a607fc8b3d",
   "t": "<FACE:7D>¿Qué haces-robo?"
  },
  {
   "key": "script:0015:0532",
   "src": "ed5a387b8bb2",
   "t": "<FACE:81>¿Eh? …Nada-robo"
  },
  {
   "key": "script:0015:0543",
   "src": "11d31dea0ffe",
   "t": "<FACE:7D>…¿Qué escondes-robo?<NL>¡Muéstralo-robo!"
  },
  {
   "key": "script:0015:055A",
   "src": "d99fc74bfb8c",
   "t": "<FACE:7D>D-déjalo-robo…"
  },
  {
   "key": "script:0015:0566",
   "src": "56f582c286f7",
   "t": "<FACE:09>Cuánto alboroto, ¿no?"
  },
  {
   "key": "script:0015:0574",
   "src": "cd19dc72efc6",
   "t": "<FACE:00>Pero no se ve nada"
  },
  {
   "key": "script:0015:0584",
   "src": "0e731bcab910",
   "t": "<FACE:08>¡Ay!"
  },
  {
   "key": "script:0015:058A",
   "src": "1075e8708520",
   "t": "<FACE:80>¡P-perdón-robo!"
  },
  {
   "key": "script:0015:0595",
   "src": "51c1461dbbde",
   "t": "<FACE:7D>¡Espera-robo!<NL><WAIT>¡Muéstramelo-robo!<NL>"
  },
  {
   "key": "script:0015:05AA",
   "src": "0d0d60b1d94b",
   "t": "<FACE:06>¡Oigan! ¿Qué les pasa?<NL><WAIT>¡Ya compórtense!<NL>Ustedes… ¿eh?"
  },
  {
   "key": "script:0015:05D4",
   "src": "d861efb9bfb6",
   "t": "<FACE:05>¿Y esto qué es?"
  },
  {
   "key": "script:0015:05DD",
   "src": "96807a661357",
   "t": "<FACE:08>¡Puaj! ¡Si es Kirika!"
  },
  {
   "key": "script:0015:05F0",
   "src": "8c21b3e9b7b1",
   "t": "<FACE:7E>Ah, la devuelvo-robo"
  },
  {
   "key": "script:0015:0629",
   "src": "0b82330d8df7",
   "t": "<FACE:04>Qué situación…"
  },
  {
   "key": "script:0015:0634",
   "src": "59eaf934ef49",
   "t": "<FACE:0A>¿Qué pasa?<NL>¡La Banda Sperobo!"
  },
  {
   "key": "script:0015:0648",
   "src": "e3c06e9b9d20",
   "t": "<FACE:81>M-mi foto de Kirika…"
  },
  {
   "key": "script:0015:065D",
   "src": "405d0f9aa243",
   "t": "<FACE:81>No puedo seguir-robo…"
  },
  {
   "key": "script:0015:0670",
   "src": "dcd95c69e514",
   "t": "<FACE:7D>No llores-robo, ánimo"
  },
  {
   "key": "script:0015:0680",
   "src": "68035033813e",
   "t": "<FACE:04>Creo que nos pasamos…"
  },
  {
   "key": "script:0015:0696",
   "src": "41116391076d",
   "t": "<FACE:05>P-perdóoon…<NL>¿Se rompió la foto?<WAIT>Es que al robobatallar<NL>me emociono de más…"
  }
 ]
}
