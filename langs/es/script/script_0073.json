{
 "part": "script/script_0073",
 "entries": [
  {
   "key": "script:0073:05B2",
   "src": "35c305a0b671",
   "t": "<FACE:00>Hiyori, ¿este bloque?"
  },
  {
   "key": "script:0073:05C1",
   "src": "14363c2787e8",
   "t": "<FACE:05>En el folleto…<NL>«Bloque temático de<WAIT>un bosque. El tema:<NL>fieras de la selva»<WAIT>Eso es lo que dice"
  },
  {
   "key": "script:0073:0609",
   "src": "b32e358e5da6",
   "t": "<FACE:00>Ah, entonces aquí…<NL><WAIT><FACE:00>exhiben Medabots que<NL>dominan el bosque…<WAIT>Igual hay alguno<NL>escondido por ahí"
  },
  {
   "key": "script:0073:0652",
   "src": "c96ffb613f77",
   "t": "<FACE:00>¿Qué pasa, Hiyori?"
  },
  {
   "key": "script:0073:0661",
   "src": "a87d395265b8",
   "t": "<FACE:05>¿No oíste algo recién?"
  },
  {
   "key": "script:0073:0673",
   "src": "97126657c62b",
   "t": "<FACE:08>¿Qué está pasando?"
  },
  {
   "key": "script:0073:067E",
   "src": "adb67abe1e73",
   "t": "<FACE:08>Estos Medabots…<NL>algo raro les pasa"
  },
  {
   "key": "script:0073:069D",
   "src": "092b627d6f3f",
   "t": "<FACE:01>(¡Esto se puso feo!)"
  },
  {
   "key": "script:0073:06AC",
   "src": "1d0033e26fe4",
   "t": "<FACE:01>¡Hiyori!<NL><WAIT><FACE:01>¡Corre a la derecha!<NL>¡Yo, a la izquierda!"
  },
  {
   "key": "script:0073:06CD",
   "src": "01aeff1e6026",
   "t": "<FACE:03>(¡Uf! Por poquito…)"
  },
  {
   "key": "script:0073:06DE",
   "src": "a7e6335fd4b9",
   "t": "<FACE:04>Aun así…"
  },
  {
   "key": "script:0073:06EA",
   "src": "8f3575f5baec",
   "t": "<FACE:04>¿Hiyori se habrá<NL>adelantado…?"
  },
  {
   "key": "script:0073:0701",
   "src": "58ff42c0921e",
   "t": "<FACE:01>Debo alcanzar a Hiyori"
  },
  {
   "key": "script:0073:0715",
   "src": "5fff42989a5f",
   "t": "<FACE:04>Eeeh…<NL><WAIT>¿Y esto…?"
  },
  {
   "key": "script:0073:0727",
   "src": "cd0f43305337",
   "t": "<FACE:03>¡Ya sé!<NL>¡Este es el control!"
  },
  {
   "key": "script:0073:0757",
   "src": "5c0304394b3c",
   "t": "<FACE:04>¿Todavía salen más…?<NL><WAIT>Así no terminaré nunca"
  },
  {
   "key": "script:0073:0774",
   "src": "23874536a89f",
   "t": "<FACE:65>Intruso detectado en<NL>el bloque… Eliminando…"
  },
  {
   "key": "script:0073:079A",
   "src": "a49a32fbab58",
   "t": "<FACE:01>Si esto sigue así…"
  },
  {
   "key": "script:0073:07A5",
   "src": "62ab0040fa03",
   "t": "<FACE:03>¡Ya sé!"
  },
  {
   "key": "script:0073:07AC",
   "src": "aef226d8dbb9",
   "t": "<FACE:00>Si toco esto, quizá…"
  },
  {
   "key": "script:0073:07C1",
   "src": "7c964338331e",
   "t": "<FACE:65>Sin anomalías en el<NL>bloque…<WAIT>Disfruten la visita…"
  },
  {
   "key": "script:0073:07ED",
   "src": "c13c34d588de",
   "t": "<FACE:00>Uf, menos mal…"
  },
  {
   "key": "script:0073:07F6",
   "src": "eed428932d66",
   "t": "<FACE:00>Parece que con esto<NL>se calman los Medabots"
  }
 ]
}
