{
 "part": "script/script_0064",
 "entries": [
  {
   "key": "script:0064:08B1",
   "src": "405633539afb",
   "t": "<FACE:01>¡Raiun! Aguanta<NL>hasta que lleguemos…"
  },
  {
   "key": "script:0064:08C6",
   "src": "038c55d97f3f",
   "t": "<FACE:79>¡Bah! Mira que yo,<NL>el gran Raiun…<WAIT>¡preocupando a unos<NL>mocosos como ustedes!"
  },
  {
   "key": "script:0064:08F1",
   "src": "642cddc6d022",
   "t": "<FACE:7B>¡Observa bien, chico!<WAIT>¡Así pelea un guerrero<NL>de verdad!!!"
  },
  {
   "key": "script:0064:0918",
   "src": "731ff086569d",
   "t": "<FACE:70>(Igual se nos unirá<NL> con mil excusas…)"
  },
  {
   "key": "script:0064:0941",
   "src": "c21c0c3e136b",
   "t": "<FACE:7C>¡¿Qué pasa aquí?!<NL>"
  },
  {
   "key": "script:0064:094E",
   "src": "4f80d3d70d3e",
   "t": "<FACE:7C>Enemigos y aliados<NL>unidos…<WAIT>¿Así piensan superar<NL>esta crisis…?"
  },
  {
   "key": "script:0064:0976",
   "src": "612e1fa4f76c",
   "t": "<FACE:79>Ya veo…"
  },
  {
   "key": "script:0064:097F",
   "src": "6424e071d81f",
   "t": "<FACE:70>¡Vaya!"
  },
  {
   "key": "script:0064:0986",
   "src": "2468f0eb4d28",
   "t": "<FACE:03>Qué inesperado…"
  },
  {
   "key": "script:0064:0990",
   "src": "d411095c65cd",
   "t": "<FACE:7B>¡Sin mí no pueden<NL>hacer nada, ustedes!"
  },
  {
   "key": "script:0064:09B0",
   "src": "259e612e4484",
   "t": "<FACE:7A>¡Andando, muchachos!"
  },
  {
   "key": "script:0064:09BE",
   "src": "ae2f146fd1bf",
   "t": "<FACE:04>Ay, ay, ay…"
  },
  {
   "key": "script:0064:09C7",
   "src": "3267d841ac08",
   "t": "<FACE:05>¿Qué haces, <PLAYER>?<NL>¡Vámonos ya!"
  },
  {
   "key": "script:0064:09DE",
   "src": "d05b12138ca0",
   "t": "<FACE:19>Ya me estoy cansando…"
  },
  {
   "key": "script:0064:09F0",
   "src": "905437ee3997",
   "t": "<FACE:0F>¿Qué te pasa? No hay<NL>más que seguir"
  },
  {
   "key": "script:0064:0A07",
   "src": "a76a52ff4053",
   "t": "<FACE:0A>Los Medabots de aquí<NL>serán duros…<WAIT>¡Me pican las manos!"
  },
  {
   "key": "script:0064:0A2A",
   "src": "fd18dd7a58ee",
   "t": "<FACE:14>¿Cuántos quedarán<NL>todavía?"
  },
  {
   "key": "script:0064:0A3C",
   "src": "64e13ea2dac3",
   "t": "<FACE:6C>¡Me preocupa Raiun!<NL>¡Hay que apurarse!"
  },
  {
   "key": "script:0064:0A55",
   "src": "2dafab104136",
   "t": "<FACE:70>Aunque sea así, es de<NL>los nuestros<WAIT>Hay que ayudarlo"
  },
  {
   "key": "script:0064:0A75",
   "src": "5951c173fb20",
   "t": "<FACE:75>Cof… cof…"
  },
  {
   "key": "script:0064:0A81",
   "src": "de1affbacaed",
   "t": "<FACE:04>(Aquí me preocupa más<NL> Smog que Raiun…)"
  },
  {
   "key": "script:0064:0AA4",
   "src": "0efdc6b13e19",
   "t": "<FACE:73>…No hay remedio…<NL>…Salvemos… a Raiun…"
  },
  {
   "key": "script:0064:0AC2",
   "src": "3ecd4a56ea6c",
   "t": "<FACE:00>¡Hay que apurarnos!"
  },
  {
   "key": "script:0064:0AD0",
   "src": "82f412e4d4ff",
   "t": "<FACE:79>¡Raiun se unió<NL>al equipo!"
  }
 ]
}
