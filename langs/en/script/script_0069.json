{
 "part": "script/script_0069",
 "entries": [
  {
   "key": "script:0069:05F9",
   "src": "7fd6ea2bfd4a",
   "t": "<FACE:05>Why do we have to keep<NL>coming back here?<WAIT>It's all jagged rocks<NL>and hard to climb"
  },
  {
   "key": "script:0069:0636",
   "src": "4ec7c2b12739",
   "t": "<FACE:1A>Couldn't agree more<NL>It's just tiring"
  },
  {
   "key": "script:0069:064C",
   "src": "8f71b936b8bb",
   "t": "<FACE:0A>What now, <PLAYER>?<NL>Leave them be?"
  },
  {
   "key": "script:0069:065C",
   "src": "ac08c8d3d3e5",
   "t": "<FACE:04>We can't do that…<NL><WAIT>If they pull something<NL>and hurt the Cluster…<WAIT><FACE:18>Yeah, no choice then…"
  },
  {
   "key": "script:0069:06A3",
   "src": "f9240f463e63",
   "t": "<FACE:09>No choice, huh…"
  },
  {
   "key": "script:0069:06B0",
   "src": "dcc42a611a9a",
   "t": "<FACE:6E>Hahaha! You came at<NL>last, I see<WAIT><FACE:6C>This time I won't hand<NL>the Block over easily"
  },
  {
   "key": "script:0069:06E7",
   "src": "7b3720cb09d1",
   "t": "<FACE:0D>Now that's an amusing<NL>thing to say"
  },
  {
   "key": "script:0069:0700",
   "src": "e331eb1093a7",
   "t": "<FACE:6C>You'll learn the power<NL>of the Sperobo Gang!"
  },
  {
   "key": "script:0069:0719",
   "src": "45116dca029f",
   "t": "<FACE:0A>Hmph. Nothing special<NL>after all<WAIT><FACE:6D>Grrrrr…<NL>"
  },
  {
   "key": "script:0069:0737",
   "src": "021be5ee6ad4",
   "t": "<FACE:6F>Retreat!"
  },
  {
   "key": "script:0069:0743",
   "src": "a17956d4a555",
   "t": "<FACE:08>Ah!"
  },
  {
   "key": "script:0069:0748",
   "src": "f567d2b61265",
   "t": "<FACE:03>What's wrong, Hiyori?"
  },
  {
   "key": "script:0069:0755",
   "src": "23d6054bed94",
   "t": "<FACE:08>I dropped my «SeeMore»<NL>Aww, my favorite too…"
  },
  {
   "key": "script:0069:077B",
   "src": "9223ee49c6ec",
   "t": "<FACE:06>Ugh, the worst!!"
  },
  {
   "key": "script:0069:0787",
   "src": "24c6eead3b9b",
   "t": "<FACE:01>…Fine, all right<NL>I'll go look for it…"
  },
  {
   "key": "script:0069:079D",
   "src": "e0e29f457899",
   "t": "<FACE:07>Hee hee…"
  },
  {
   "key": "script:0069:07A5",
   "src": "0b3409935adf",
   "t": "<FACE:02>Found it! Found it!"
  },
  {
   "key": "script:0069:07B0",
   "src": "09513ae1c0a7",
   "t": "<FACE:00>Phew, there we go"
  },
  {
   "key": "script:0069:07BA",
   "src": "0a0fadc3505f",
   "t": "<FACE:07>Hee hee, thanks"
  },
  {
   "key": "script:0069:07C4",
   "src": "769c3f2e0fb0",
   "t": "<FACE:00>I've got to find the<NL>«SeeMore»<NL>"
  },
  {
   "key": "script:0069:07D7",
   "src": "0d1cd8bae38f",
   "t": "<FACE:00>No time to go back now"
  },
  {
   "key": "script:0069:07EC",
   "src": "dc69d51d4392",
   "t": "<FACE:05>Well then,<NL>I'll go on ahead"
  }
 ]
}
