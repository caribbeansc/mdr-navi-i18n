{
 "part": "script/script_0036",
 "entries": [
  {
   "key": "script:0036:0881",
   "src": "3eceefa0e7aa",
   "t": "<FACE:5A>Move it! Move it!<NL>You're in my shot!"
  },
  {
   "key": "script:0036:089D",
   "src": "a5cbd9b5341e",
   "t": "<FACE:5C>Aaaaaaah!!<NL>Shideeeeen!!"
  },
  {
   "key": "script:0036:08B8",
   "src": "53b4121cc3f7",
   "t": "<FACE:06>What's so great about<NL>that airhead? Idiots!"
  },
  {
   "key": "script:0036:08D8",
   "src": "bf9d2b7b5ce7",
   "t": "<FACE:03>H-hey, Hiyori!"
  },
  {
   "key": "script:0036:08E4",
   "src": "4edb1140e0bd",
   "t": "<FACE:22>Come on, everyone!<NL>Time to board at last"
  },
  {
   "key": "script:0036:0904",
   "src": "134046749c1b",
   "t": "<FACE:23>(Tch!)"
  },
  {
   "key": "script:0036:090C",
   "src": "cbccb5cc3e2a",
   "t": "<FACE:22>Come on, hurry, hurry!"
  },
  {
   "key": "script:0036:091C",
   "src": "71eddde468a9",
   "t": "<FACE:23>(Wish they'd miss it…)"
  },
  {
   "key": "script:0036:0931",
   "src": "5c63e4117963",
   "t": "<FACE:06>Honestly! Don't go<NL>wandering off alone!"
  },
  {
   "key": "script:0036:094A",
   "src": "1db3b8f07b33",
   "t": "<FACE:5D>I came to see Shiden"
  },
  {
   "key": "script:0036:095D",
   "src": "51233595cf05",
   "t": "<FACE:5C>Shiden's so cool!"
  },
  {
   "key": "script:0036:0970",
   "src": "4bc8d3292c3e",
   "t": "<FACE:5E>The best Medafighter<NL>has to be Shiden"
  },
  {
   "key": "script:0036:098B",
   "src": "4bb000fe1539",
   "t": "<FACE:5C>I came to see Shiden,<NL>but it's so crowded…"
  },
  {
   "key": "script:0036:09AE",
   "src": "88c1c856b78e",
   "t": "<FACE:5C>Did you come to see<NL>Shiden too?"
  },
  {
   "key": "script:0036:09C6",
   "src": "78444c6e7ca2",
   "t": "<FACE:5E>…Shiden[<3]"
