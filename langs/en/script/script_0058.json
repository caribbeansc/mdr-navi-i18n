  {
   "key": "script:0058:04F7",
   "src": "d6e2c59e3bbd",
   "t": "<FACE:73>True… our gathering<NL>ruined… Unforgivable…"
  },
  {
   "key": "script:0058:0514",
   "src": "d3e8e018fc7d",
   "t": "<FACE:73>…A shame… Again I'll…<NL>take this Block back…"
  },
  {
   "key": "script:0058:0535",
   "src": "78f0fa278af0",
   "t": "<FACE:00>If it's not the otaku<NL>group, then who?"
  },
  {
   "key": "script:0058:0555",
   "src": "e3e0ab7fd220",
   "t": "<FACE:05>This place gives me<NL>the creeps every time"
  },
  {
   "key": "script:0058:0567",
   "src": "c8cbc8dc0603",
   "t": "<FACE:0A>Go check the back<NL>room too"
  },
  {
   "key": "script:0058:0577",
   "src": "052e26444215",
   "t": "<FACE:19>I got a bad feeling<NL>about this, I do"
  },
  {
   "key": "script:0058:0589",
   "src": "8a5e8197a6d7",
   "t": "<FACE:14>The otaku group was in<NL>this Block, I recall"
