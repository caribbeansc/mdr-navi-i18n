  {
   "key": "script:0025:163B",
   "src": "3735cfbe1eb0",
   "t": "<FACE:02>Oh! There they are!<NL>"
  },
  {
   "key": "script:0025:1646",
   "src": "015085738969",
   "t": "<FACE:02>Found 'em! Um, uhhh…"
