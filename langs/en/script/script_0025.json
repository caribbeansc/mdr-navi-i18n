  },
  {
   "key": "script:0025:15D5",
   "src": "7042c0fad573",
   "t": "<FACE:03>…Right as I say it…<NL>Aaaaah!"
  },
  {
   "key": "script:0025:15EF",
   "src": "d7ef4b5a9af3",
   "t": "<FACE:01>Hiyori, don't wander!<NL>"
  },
  {
   "key": "script:0025:15FE",
   "src": "48f2071a7a61",
   "t": "<FACE:03>(You're kidding me!)<NL>"
  },
  {
   "key": "script:0025:160E",
   "src": "e035d1484bac",
   "t": "<FACE:03>Heeey! Hiyoriii!<NL>"
  },
  {
   "key": "script:0025:161B",
   "src": "d560ed841566",
   "t": "<FACE:03>Fubukiii!<NL><WAIT>Mizore! Gousetsuuu!<NL><WAIT>Answer meee!"
